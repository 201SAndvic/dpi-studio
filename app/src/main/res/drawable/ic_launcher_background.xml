    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 淡蓝底：浅、柔，和参考图标一致 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="0"
                android:endX="100"
                android:endY="108">
                <item android:offset="0.0" android:color="#FFD2E1FD" />
                <item android:offset="0.5" android:color="#FFB7CDFA" />
                <item android:offset="1.0" android:color="#FF9BBBF5" />
