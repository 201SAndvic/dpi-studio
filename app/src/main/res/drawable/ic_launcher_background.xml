    </path>

    <!-- 左上角一层柔光，避免发闷 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="26"
                android:centerY="18"
                android:gradientRadius="80">
                <item android:offset="0.0" android:color="#3DFFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
